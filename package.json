{
  "name": "pokecord-mobile",
  "private": true,
  "version": "0.1.0",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": "1.4.2",
    "node": ">=22.14.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:mobile": "bun run --cwd apps/mobile start",
    "dev:field": "bun run --cwd apps/mobile field",
    "dev:server": "bun run --cwd apps/server dev",
    "db:up": "docker compose -f infra/compose.dev.yml up -d --wait",
    "db:down": "docker compose -f infra/compose.dev.yml down",
    "db:migrate": "bun run --cwd apps/server db:migrate",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test packages apps/server/src",
    "test:integration": "bun test apps/server/integration",
    "check": "bun run lint && bun run typecheck && bun run test",
    "mobile:check": "bun run --cwd apps/mobile doctor",
    "mobile:export": "bun run --cwd apps/mobile export:android"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.4",
    "@types/bun": "1.3.10",
    "typescript": "~6.0.3"
  }
}
